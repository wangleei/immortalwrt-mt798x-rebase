#!/bin/sh /etc/rc.common
#
# /etc/init.d/n60pro-optimize
# N60 PRO 启动优化脚本
# 在系统启动完成后执行一次性优化
#

START=95
STOP=10

boot() {
    # 延迟到系统完全启动后
    sleep 5
    start
}

start() {
    local LOG_TAG="n60pro-optimize"
    logger -t "$LOG_TAG" "Applying N60 PRO optimizations..."

    # ====================================================================
    # 1. CPU Governor — ondemand (空闲降频，负载升频)
    # ====================================================================
    if [ -d /sys/devices/system/cpu/cpufreq ]; then
        for policy in /sys/devices/system/cpu/cpufreq/policy*; do
            if [ -f "$policy/scaling_governor" ]; then
                echo "ondemand" > "$policy/scaling_governor" 2>/dev/null || true
                logger -t "$LOG_TAG" "CPU governor: ondemand ($(cat $policy/scaling_governor 2>/dev/null))"
            fi
        done
    fi

    # ====================================================================
    # 2. IRQ Balance — 启动中断均衡
    # ====================================================================
    if [ -x /usr/sbin/irqbalance ]; then
        /usr/sbin/irqbalance -t 100 &
        logger -t "$LOG_TAG" "IRQ balance started"
    fi

    # ====================================================================
    # 3. WiFi 优化 — 功率 + 低延迟
    # ====================================================================
    for ra_if in ra0 rai0; do
        if [ -d "/sys/class/net/$ra_if" ]; then
            ifconfig "$ra_if" up 2>/dev/null || true

            # TX 功率 25dBm (100% SKU)
            iwpriv "$ra_if" set TxPower=100 2>/dev/null || true

            # 关闭 TWT — 防止某些客户端速率暴跌和高延迟
            iwpriv "$ra_if" set TWTEnable=0 2>/dev/null || true

            # 强制开启 WMM (QoS) 和 Short GI — 降低延迟
            iwpriv "$ra_if" set WmmCapable=1 2>/dev/null || true

            # 关闭 GreenAP — 防止节能模式引起延迟抖动
            iwpriv "$ra_if" set GreenAP=0 2>/dev/null || true

            logger -t "$LOG_TAG" "WiFi $ra_if: TX=25dBm, TWT=off, WMM=on, GreenAP=off"
        fi
    done

    # ====================================================================
    # 4. 网络接口 RPS (Receive Packet Steering) — 分散网卡中断
    # ====================================================================
    # 获取 CPU 核心数
    CPU_COUNT=$(nproc 2>/dev/null || echo 4)
    # 计算 CPU 掩码 (所有核心)
    if [ "$CPU_COUNT" -gt 0 ]; then
        RPS_MASK=$(( (1 << CPU_COUNT) - 1 ))
        # 转换为十六进制
        RPS_MASK_HEX=$(printf "%x" $RPS_MASK)

        # 为所有物理网卡启用 RPS
        for iface in eth0 eth1 lan1 lan2 lan3 lan4; do
            if [ -d "/sys/class/net/$iface" ]; then
                echo "$RPS_MASK_HEX" > "/sys/class/net/$iface/queues/rx-0/rps_cpus" 2>/dev/null || true
            fi
        done
        logger -t "$LOG_TAG" "RPS enabled with CPU mask: $RPS_MASK_HEX"
    fi

    # ====================================================================
    # 5. zram swap — 确保 zram 正确配置
    # ====================================================================
    if [ -x /sbin/zramctl ]; then
        # 默认 zram-swap 包已在 /etc/config/system 中配置
        # 这里确保它运行在最佳设置
        if [ -e /dev/zram0 ]; then
            # 强制使用 zstd 压缩
            echo "zstd" > /sys/block/zram0/comp_algorithm 2>/dev/null || true
            logger -t "$LOG_TAG" "zram compression: $(cat /sys/block/zram0/comp_algorithm 2>/dev/null)"
        fi
    fi

    # ====================================================================
    # 6. 应用 sysctl 配置
    # ====================================================================
    if [ -f /etc/sysctl.d/10-n60pro-network.conf ]; then
        sysctl -p /etc/sysctl.d/10-n60pro-network.conf 2>/dev/null || true
        logger -t "$LOG_TAG" "sysctl network tuning applied"
    fi

    # ====================================================================
    # 7. HNAT 状态确认
    # ====================================================================
    if grep -q "mtkhnat" /proc/modules 2>/dev/null; then
        logger -t "$LOG_TAG" "HNAT module loaded: OK"
    fi
    if grep -q "warp" /proc/modules 2>/dev/null; then
        logger -t "$LOG_TAG" "WARP module loaded: OK"
    fi

    # ====================================================================
    # 8. 设置系统主机名
    # ====================================================================
    uci set system.@system[0].hostname='N60Pro' 2>/dev/null || true
    uci commit system 2>/dev/null || true

    logger -t "$LOG_TAG" "All optimizations applied successfully"
    echo "N60 PRO optimized. Free memory: $(free -m | awk '/Mem:/{print $4}')MB"
}

stop() {
    # 停止 irqbalance
    killall irqbalance 2>/dev/null || true
    logger -t "n60pro-optimize" "Optimizations stopped"
}

restart() {
    stop
    start
}
