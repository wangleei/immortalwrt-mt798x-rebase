#
# /etc/config/wireless — N60 PRO WiFi 配置
# 2.4GHz + 5GHz 双频，目标功率 25dBm
#

config wifi-device 'radio0'
	option type 'mt_wifi'
	option channel 'auto'
	option band '2g'
	option hwmode '11ax'
	option htmode 'HE40'
	option country 'CN'
	option txpower '25'
	option txpower_max '25'
	option rts '2347'
	option frag '2346'
	option disabled '0'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'N60Pro-2.4G'
	option encryption 'psk2+ccmp'
	option key 'changeme123'
	option wpa_group_rekey '3600'
	option wpa_disable_eapol_key_retries '1'

config wifi-device 'radio1'
	option type 'mt_wifi'
	option channel 'auto'
	option band '5g'
	option hwmode '11ax'
	option htmode 'HE160'
	option country 'CN'
	option txpower '25'
	option txpower_max '25'
	option rts '2347'
	option frag '2346'
	option disabled '0'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid 'N60Pro-5G'
	option encryption 'psk2+ccmp'
	option key 'changeme123'
	option wpa_group_rekey '3600'
	option wpa_disable_eapol_key_retries '1'
